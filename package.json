{
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  },
  "scripts": {
    "watch": "npx tailwindcss -i ./src/style.css -o ./dist/style.css --watch",
    "build": "npx tailwindcss -i ./src/style.css -o ./dist/style.css && copy index.html dist/index.html",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  }
}
